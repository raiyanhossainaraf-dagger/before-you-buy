# Before You Buy — every environment variable (TRD §28).
# Copy to .env.local with local values filled in:  pnpm env:local
# Nothing secret may use the NEXT_PUBLIC_ prefix (rule 13).

# --- Core ---------------------------------------------------------------------
APP_ENV=local                              # local | preview | production
APP_DOMAIN=beforeyoubuy.local              # DECIDE-09: placeholder until a domain is chosen
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001           # M1: the Hono service
COOKIE_DOMAIN=localhost

# --- Data ---------------------------------------------------------------------
DATABASE_URL=postgres://byb:byb@localhost:5432/byb
DATABASE_URL_UNPOOLED=postgres://byb:byb@localhost:5432/byb
REDIS_URL=redis://localhost:6379

# --- Auth (M3) ----------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-32-plus-random-characters

# --- Abuse control ------------------------------------------------------------
# Cloudflare's documented always-pass test pair. Server-side verification is
# real; only the keys are test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Signing ------------------------------------------------------------------
LINK_SIGNING_SECRET=replace-with-32-plus-random-characters
API_KEY_PEPPER=replace-with-32-plus-random-characters
IP_HASH_SALT_SEED=replace-with-32-plus-random-characters
REVALIDATE_SECRET=replace-with-32-plus-random-characters

# --- Email --------------------------------------------------------------------
EMAIL_TRANSPORT=smtp                       # smtp (Mailpit) | resend
EMAIL_FROM="Before You Buy <hello@beforeyoubuy.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=                            # required when EMAIL_TRANSPORT=resend
RESEND_WEBHOOK_SECRET=

# --- Payments -----------------------------------------------------------------
PAYMENTS_PROVIDER=mock                     # mock (local checkout page) | stripe
STRIPE_SECRET_KEY=                         # required when PAYMENTS_PROVIDER=stripe
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# --- Analytics ----------------------------------------------------------------
ANALYTICS_TRANSPORT=console                # console (local) | posthog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_API_KEY=

# --- Providers (M4/M5) --------------------------------------------------------
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SCRAPER_DATASET_ID=
BACKUP_UNBLOCKER_PROVIDER=
BACKUP_UNBLOCKER_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
BESTBUY_API_KEY=

# --- Affiliate (M16) ----------------------------------------------------------
AMAZON_ASSOCIATE_TAG=
EBAY_EPN_CAMPAIGN_ID=
BESTBUY_AFFILIATE_ID=

# --- AI (M6) ------------------------------------------------------------------
AI_PROVIDER=google
AI_MODEL_MATCH=
AI_MODEL_TEXT=
AI_MODEL_EMBED=
AI_EMBED_DIMENSIONS=768                    # DECIDE-14
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Spend --------------------------------------------------------------------
DAILY_SPEND_CAP_CENTS=1000                 # DECIDE-18: $10/day at launch

# --- Observability (M1.5) -----------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
